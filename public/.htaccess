RewriteEngine On
RewriteBase /portfolio/

DirectoryIndex index.html
ErrorDocument 404 /portfolio/404.html

# Old URLs from the previous site
RewriteRule ^about(\.php)?$ /portfolio/ [R=301,L]
RewriteRule ^projects(\.php)?$ /portfolio/#work [R=301,NE,L]
RewriteRule ^index\.php$ /portfolio/ [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets and the frame sequence never change in place
  <FilesMatch "\.(webp|woff2|mp4|webm|jpg)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 10 minutes"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|woff2|mp4|webm|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
